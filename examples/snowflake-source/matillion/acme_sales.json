              "elements": {
                "1": {
                  "slot": 1,
                  "values": {
                    "1": {
                      "slot": 1,
                      "type": "STRING",
                      "value": "Create Dimension Tables"
                    }
                  }
                }
              },
              "visible": true
            },
            "2": {
              "slot": 2,
              "name": "SQL Script",
              "elements": {
                "1": {
                  "slot": 1,
                  "values": {
                    "1": {
                      "slot": 1,
                      "type": "STRING",
                      "value": "CREATE OR REPLACE TABLE ${v_e_sales_db}.SALES.DIM_PRODUCTS AS\nSELECT PRODUCT_ID::NUMBER          AS PRODUCT_ID,\n       PRODUCT_NAME,\n       IFF(CATEGORY IS NULL, 'UNKNOWN', CATEGORY) AS CATEGORY,\n       CURRENT_TIMESTAMP()         AS LOADED_AT\nFROM ${v_e_sales_db}.RAW.PRODUCTS_SRC;\n\nCREATE OR REPLACE TABLE ${v_e_sales_db}.SALES.DIM_REGIONS AS\nSELECT REGION_ID::NUMBER AS REGION_ID, REGION_NAME\nFROM ${v_e_sales_db}.RAW.REGIONS_SRC;\n\nGRANT SELECT ON ALL TABLES IN SCHEMA ${v_e_sales_db}.SALES TO ROLE REPORTING_RO;"
                    }
                  }
                }
              },
              "visible": true
            }
          },
          "exportMappings": {},
          "activationStatus": "ENABLED"
        },
        "1003": {
          "id": 1003,
