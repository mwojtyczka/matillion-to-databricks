              "visible": true
            },
            "2": {
              "slot": 2,
              "name": "SQL Script",
              "elements": {
                "1": {
                  "slot": 1,
                  "values": {
                    "1": {
                      "slot": 1,
                      "type": "STRING",
                      "value": "CREATE OR REPLACE TABLE ${v_e_sales_db}.SALES.FACT_SALES AS\nSELECT SALE_ID::NUMBER      AS SALE_ID,\n       PRODUCT_ID::NUMBER   AS PRODUCT_ID,\n       REGION_ID::NUMBER    AS REGION_ID,\n       QUANTITY::NUMBER     AS QUANTITY,\n       REVENUE::FLOAT       AS REVENUE\nFROM ${v_e_sales_db}.RAW.SALES_SRC\nQUALIFY ROW_NUMBER() OVER (PARTITION BY SALE_ID ORDER BY LOADED_AT DESC) = 1;"
                    }
                  }
                }
              },
              "visible": true
            }
          },
